<?php
// fork: settings UI for the UGREEN LED driver

$cfgFile = '/boot/config/plugins/ugreenleds-driver/settings.cfg';

$cfgOrder = array(
  'MAPPING_METHOD', 'DISK_SERIAL', 'COLOR_DISK_HEALTH', 'BRIGHTNESS_DISK_LEDS', 'COLOR_DISK_UNAVAIL',
  'LED_REFRESH_INTERVAL', 'CHECK_DISK_ONLINE_INTERVAL', 'CHECK_GATEWAY_CONNECTIVITY',
  'COLOR_NETDEV_NORMAL', 'COLOR_NETDEV_LINK_100', 'COLOR_NETDEV_LINK_1000', 'COLOR_NETDEV_LINK_2500',
  'COLOR_NETDEV_LINK_10000', 'COLOR_NETDEV_GATEWAY_UNREACHABLE', 'CHECK_NETDEV_INTERVAL',
  'BRIGHTNESS_NIGHT', 'BRIGHTNESS_POWER_DAY', 'NIGHT_MODE_ENABLED', 'NIGHT_START_HOUR', 'NIGHT_END_HOUR',
  'DISK_LED_INVERT', 'NETDEV_LED_MODE', 'ARRAY_HEALTH_LED', 'PARITY_PROGRESS_LED', 'UPS_ALERT_LED',
);

$cfgDefaults = array(
  'MAPPING_METHOD' => 'ata',
  'DISK_SERIAL' => 'SN1 SN2 SN3 SN4',
  'COLOR_DISK_HEALTH' => '255 255 255',
  'BRIGHTNESS_DISK_LEDS' => '255',
  'COLOR_DISK_UNAVAIL' => '255 0 0',
  'LED_REFRESH_INTERVAL' => '0.5',
  'CHECK_DISK_ONLINE_INTERVAL' => '5',
  'CHECK_GATEWAY_CONNECTIVITY' => 'true',
  'COLOR_NETDEV_NORMAL' => '255 165 0',
  'COLOR_NETDEV_LINK_100' => '0 255 0',
  'COLOR_NETDEV_LINK_1000' => '0 0 255',
  'COLOR_NETDEV_LINK_2500' => '255 255 0',
  'COLOR_NETDEV_LINK_10000' => '255 255 255',
  'COLOR_NETDEV_GATEWAY_UNREACHABLE' => '255 0 0',
  'CHECK_NETDEV_INTERVAL' => '30',
  'BRIGHTNESS_NIGHT' => '15',
  'BRIGHTNESS_POWER_DAY' => '128',
  'NIGHT_MODE_ENABLED' => 'false',
  'NIGHT_START_HOUR' => '22',
  'NIGHT_END_HOUR' => '7',
  'DISK_LED_INVERT' => '1',
  'NETDEV_LED_MODE' => 'netdev',
  'ARRAY_HEALTH_LED' => 'false',
  'PARITY_PROGRESS_LED' => 'true',
  'UPS_ALERT_LED' => 'true',
);

function ugreenleds_read_cfg($file, $defaults) {
  $parsed = @parse_ini_file($file);
  if (!is_array($parsed)) $parsed = array();
  return array_merge($defaults, $parsed);
}

function ugreenleds_write_cfg($file, $cfg, $order) {
  $out = '';
  foreach ($order as $key) {
    $out .= $key.'="'.$cfg[$key].'"'."\n";
  }
  file_put_contents($file, $out);
}

function ugreenleds_valid_int($v, $min, $max) {
  return ctype_digit((string)$v) && (int)$v >= $min && (int)$v <= $max;
}
function ugreenleds_valid_color($v) {
  if (!preg_match('/^([0-9]{1,3}) ([0-9]{1,3}) ([0-9]{1,3})$/', trim((string)$v), $m)) return false;
  return (int)$m[1] <= 255 && (int)$m[2] <= 255 && (int)$m[3] <= 255;
}
function ugreenleds_valid_number($v) {
  return is_numeric($v) && (float)$v > 0;
}

$cfg = ugreenleds_read_cfg($cfgFile, $cfgDefaults);

// fork: POST handlers — restart daemon only
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['restart'])) {
  shell_exec('bash /usr/local/emhttp/plugins/ugreenleds-driver/include/apply.sh restart >/dev/null 2>&1 &');
  echo '<script>parent.window.location.replace(parent.window.location.pathname + parent.window.location.search);</script>';
  exit;
}

// fork: POST handler — validate and persist settings, then re-apply
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['apply'])) {
  $new = $cfg;

  if (isset($_POST['MAPPING_METHOD']) && in_array($_POST['MAPPING_METHOD'], array('ata', 'hctl', 'serial'), true)) {
    $new['MAPPING_METHOD'] = $_POST['MAPPING_METHOD'];
  }

  if (isset($_POST['DISK_SERIAL'])) {
    $serial = trim((string)($_POST['DISK_SERIAL'] ?? ''));  // fork: cast guards against array POSTs
    if ($serial !== '' && preg_match('/^[A-Za-z0-9 _-]+$/', $serial)) {
      $new['DISK_SERIAL'] = $serial;
    }
  }

  foreach (array(
    'COLOR_DISK_HEALTH', 'COLOR_DISK_UNAVAIL', 'COLOR_NETDEV_NORMAL', 'COLOR_NETDEV_LINK_100',
    'COLOR_NETDEV_LINK_1000', 'COLOR_NETDEV_LINK_2500', 'COLOR_NETDEV_LINK_10000',
    'COLOR_NETDEV_GATEWAY_UNREACHABLE',
  ) as $key) {
    if (isset($_POST[$key]) && ugreenleds_valid_color($_POST[$key])) {
      $new[$key] = trim($_POST[$key]);
    }
  }

  foreach (array('BRIGHTNESS_DISK_LEDS', 'BRIGHTNESS_NIGHT', 'BRIGHTNESS_POWER_DAY') as $key) {
    if (isset($_POST[$key]) && ugreenleds_valid_int($_POST[$key], 0, 255)) {
      $new[$key] = (string)(int)$_POST[$key];
    }
  }

  foreach (array('NIGHT_START_HOUR', 'NIGHT_END_HOUR') as $key) {
    if (isset($_POST[$key]) && ugreenleds_valid_int($_POST[$key], 0, 23)) {
      $new[$key] = (string)(int)$_POST[$key];
    }
  }

  foreach (array('LED_REFRESH_INTERVAL', 'CHECK_DISK_ONLINE_INTERVAL', 'CHECK_NETDEV_INTERVAL') as $key) {
    if (isset($_POST[$key]) && ugreenleds_valid_number($_POST[$key])) {
      $new[$key] = trim($_POST[$key]);
    }
  }

  foreach (array('CHECK_GATEWAY_CONNECTIVITY', 'NIGHT_MODE_ENABLED') as $key) {
    if (isset($_POST[$key]) && in_array($_POST[$key], array('true', 'false'), true)) {
      $new[$key] = $_POST[$key];
    }
  }

  if (isset($_POST['DISK_LED_INVERT']) && in_array($_POST['DISK_LED_INVERT'], array('0', '1'), true)) {
    $new['DISK_LED_INVERT'] = $_POST['DISK_LED_INVERT'];
  }

  if (isset($_POST['NETDEV_LED_MODE']) && in_array($_POST['NETDEV_LED_MODE'], array('netdev', 'breathe'), true)) {
    $new['NETDEV_LED_MODE'] = $_POST['NETDEV_LED_MODE'];
  }

  foreach (array('ARRAY_HEALTH_LED', 'PARITY_PROGRESS_LED', 'UPS_ALERT_LED') as $key) {
    if (isset($_POST[$key]) && in_array($_POST[$key], array('true', 'false'), true)) {
      $new[$key] = $_POST[$key];
    }
  }

  ugreenleds_write_cfg($cfgFile, $new, $cfgOrder);
  $cfg = $new;
  shell_exec('bash /usr/local/emhttp/plugins/ugreenleds-driver/include/apply.sh apply >/dev/null 2>&1 &');
  echo '<script>parent.window.location.replace(parent.window.location.pathname + parent.window.location.search);</script>';
  exit;
}

$running = trim((string)shell_exec('pgrep -f /usr/bin/ugreen-leds 2>/dev/null'));
$isRunning = $running !== '';
$model = trim((string)shell_exec('dmidecode --string system-product-name 2>/dev/null'));

function h($v) { return htmlspecialchars((string)$v, ENT_QUOTES); }
function ugreenleds_rgb_to_hex($rgb) {
  $p = preg_split('/\s+/', trim((string)$rgb));
  if (count($p) !== 3) return '#ffffff';
  return sprintf('#%02x%02x%02x', (int)$p[0], (int)$p[1], (int)$p[2]);
}
