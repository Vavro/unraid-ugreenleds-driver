<script>
function ugHexToRgbTriplet(hex) {
  hex = hex.replace('#', '');
  var r = parseInt(hex.substring(0, 2), 16);
  var g = parseInt(hex.substring(2, 4), 16);
  var b = parseInt(hex.substring(4, 6), 16);
  return r + ' ' + g + ' ' + b;
}
function ugRgbTripletToHex(triplet) {
  var p = String(triplet).trim().split(/\s+/).map(Number);
  if (p.length !== 3 || p.some(isNaN)) return '#ffffff';
  return '#' + p.map(function(n) {
    return ('0' + Math.max(0, Math.min(255, n)).toString(16)).slice(-2);
  }).join('');
}
function ugEnableApply() {
  $('#ugreenleds-apply').prop('disabled', false).removeAttr('disabled');
}

$(function() {
  // fork: sync color pickers from their hidden R G B fields on load
  $('.ug-color-picker').each(function() {
    var hidden = $('#' + $(this).data('target'));
    $(this).val(ugRgbTripletToHex(hidden.val()));
  });

  // fork: on color change, update hidden field and post a live preview
  $('.ug-color-picker').on('change input', function() {
    var hidden = $('#' + $(this).data('target'));
    var triplet = ugHexToRgbTriplet(this.value);
    hidden.val(triplet).trigger('change');
    setTimeout(ugEnableApply, 0);
    var target = $(this).data('preview');
    if (target) {
      $.post('/plugins/ugreenleds-driver/include/preview.php', {target: target, color: triplet, csrf_token: ugreenCsrf});
    }
  });

  // fork: live brightness value labels
  $('.ug-brightness').on('input', function() {
    $('#' + $(this).data('label')).text(this.value);
  });

  // fork: only show disk serial row when mapping method is "serial"
  function ugToggleSerialRow() {
    $('#disk_serial_row').toggle($('#mapping_method').val() === 'serial');
  }
  $('#mapping_method').on('change', ugToggleSerialRow);
  ugToggleSerialRow();
});

// fork: reset live preview back to the saved config when leaving the page without Apply
window.addEventListener('pagehide', function() {
  navigator.sendBeacon('/plugins/ugreenleds-driver/include/preview.php', new URLSearchParams({target: 'reset', csrf_token: ugreenCsrf}));
});
</script>
