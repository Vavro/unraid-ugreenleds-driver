UNRAID_VERSION=7.3.2
KERNEL_VERSION=6.18.38-Unraid
SHA256SUM_PATH=/usr/bin/sha256sum
WGET_PATH=/usr/bin/wget
INSTALL_PATH=/usr/bin/install
MODINFO_PATH=/sbin/modinfo
INSTALLPKG_PATH=/sbin/installpkg
DEPMOD_PATH=/sbin/depmod
AT_PATH=/usr/bin/at
UPDATE_CRON_PATH=/usr/local/sbin/update_cron
PGREP_PATH=/usr/bin/pgrep
PKILL_PATH=/usr/bin/pkill
PLUGIN_PATH=/usr/local/sbin/plugin
AT_EXECUTES_COMMANDS=true
PLUGIN_MANAGER_SUPPORTS_SHA256=true
PLUGIN_MANAGER_SUPPORTS_MIN_MAX=true
PREINSTALL_HAS_UGREEN_MODULE=false
