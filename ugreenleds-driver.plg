<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name        "ugreenleds-driver">
  <!ENTITY author      "Vavro">
  <!ENTITY version     "2026.09.06.7">
  <!ENTITY release     "v2026.09.06.7">
  <!ENTITY package-version "2026.09.06.5">
  <!ENTITY package-sha256 "aaafbc9c26bc4ed773bcd14ebf7a7f7f4cf247869c1d9153bedcf400803b2b05">
  <!ENTITY i2c-version "4.3">
  <!ENTITY i2c-sha256  "9730e890d81743f4827715ae38019715fe8252c9bc6d95af4b5f64339238106c">
  <!ENTITY kernel-version "6.18.38-Unraid">
  <!ENTITY kernel-package "ugreen_leds-20260705-6.18.38-Unraid-1.txz">
  <!ENTITY kernel-sha256 "744a5bcb62fa0d8a831897617800b29c330026981e14e3041829383329648afa">
  <!ENTITY helper-commit "f0562fc1add4ed20c20451bf17f570502bc7ed00">
  <!ENTITY helper-sha256 "e528862eb9499b952d44cdd9b3ee1a44f3c7803cc7ea979272a5bb18e365b043">
  <!ENTITY gitURL      "https://raw.githubusercontent.com/&author;/unraid-&name;/&release;">
  <!ENTITY pluginURL   "&gitURL;/&name;.plg">
  <!ENTITY plugin      "/boot/config/plugins/&name;">
  <!ENTITY emhttp      "/usr/local/emhttp/plugins/&name;">
  <!ENTITY packages    "/boot/config/plugins/&name;/packages">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" min="7.3.2" max="7.3.2" support="https://github.com/Vavro/unraid-ugreenleds-driver/issues">

<CHANGES>

###2026.09.06.7
- Skip duplicate I2C client registration when the LED controller already exists

###2026.09.06.6
- Explicitly enable Apply after Dynamix processes a color-only change

###2026.09.06.5
- Enable Apply when a color picker is the only changed setting

###2026.09.06.4
- Restore the normal white power LED when array-health coloring is disabled

###2026.09.06.3
- Restore WebGUI registration by packaging plugin page metadata with Unix line endings

###2026.09.06.2
- Prevent Apply and Restart Daemon from repeatedly resubmitting their POST request

###2026.09.06.1
- Pin the plugin update source to an immutable release tag
- Restrict installation to the reviewed Unraid 7.3.2 release
- Verify plugin, I2C tools, helper, and kernel module artifacts with SHA-256
- Pin the update helper and kernel module to reviewed immutable artifacts
- Fail closed instead of selecting mutable release assets at installation time

###2026.07.05
- Fork of ich777/unraid-ugreenleds-driver, credit to ich777 for the original plugin
- Add Settings UI page under Settings > Utilities
- Add night mode (scheduled dimming) with configurable brightness and time window
- Add configurable disk LED invert (activity-only vs. always-on)
- Add daemon status indicator (running/stopped, NAS model) on the settings page
- Add live color preview for disk and network LEDs before applying

###2024.07.12
- Increase the interval from netdev to 500ms

###2024.06.28
- Unteather ugreen-leds script from driver package
- Add support for DX4700 - thanks miskcoo
- Add support for DXP2800 - thanks miskcoo

###2024.06.27
- Bugfixes for HDD LEDs
- Add DXP480T and set LED to static white
- Move modprobe routine into ugreen-leds script

###2024.06.26
- Bugfixes for LEDs not starting correctly

###2024.06.19
- Initial release

</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
kill $(pgrep -f "/usr/bin/ugreen-leds") >/dev/null 2>&amp;1
rm -f $(ls &plugin;/&name;-*.txz 2>/dev/null|grep -v '&package-version;')
</INLINE>
</FILE>

<FILE Name="&plugin;/&name;-&package-version;.txz" Run="upgradepkg --install-new">
<URL>&gitURL;/packages/&name;-&package-version;.txz</URL>
<SHA256>&package-sha256;</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
rm -f $(ls &plugin;/i2c-tools-*-x86_64-1.txz 2>/dev/null|grep -v '&i2c-version;')
</INLINE>
</FILE>

<FILE Name="&plugin;/i2c-tools-&i2c-version;-x86_64-1.txz" Run="upgradepkg --install-new">
<URL>&gitURL;/packages/i2c-tools-&i2c-version;-x86_64-1.txz</URL>
<SHA256>&i2c-sha256;</SHA256>
</FILE>


<FILE Name="&emhttp;/README.md">
<INLINE>
**UGREEN LED Driver**

This package contains the UGREEN LED Driver which will allow you to get your LEDs to work on your UGREEN NAS (please note that not all models are supported).
The plugin is based on: https://github.com/miskcoo/ugreen_dx4600_leds_controller
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>

download() {
local destination="&packages;/${KERNEL_V%%-*}/${KERNEL_PACKAGE}"
local temporary="${destination}.tmp"
rm -f "${temporary}"
if wget -q --show-progress --progress=bar:force:noscroll -O "${temporary}" "${KERNEL_URL}" ; then
  if ! echo "${KERNEL_SHA256}  ${temporary}" | sha256sum -c - >/dev/null 2>&amp;1 ; then
    echo
    echo "-----ERROR - ERROR - ERROR - ERROR - ERROR - ERROR - ERROR - ERROR - ERROR------"
    echo "----------------------KERNEL PACKAGE CHECKSUM ERROR!--------------------------"
    rm -f "${temporary}"
    exit 1
  fi
  mv -f "${temporary}" "${destination}"
  echo
  echo "----------Successfully downloaded UGREEN LED Driver, please wait...!-----------"
else
  echo
  echo "-----ERROR - ERROR - ERROR - ERROR - ERROR - ERROR - ERROR - ERROR - ERROR-----"
  echo "---------------------Can't download UGREEN LED Driver--------------------------"
  rm -f "${temporary}"
  exit 1
fi
}

check() {
local destination="&packages;/${KERNEL_V%%-*}/${KERNEL_PACKAGE}"
if [ ! -f "${destination}" ] || ! echo "${KERNEL_SHA256}  ${destination}" | sha256sum -c - >/dev/null 2>&amp;1 ; then
  rm -f "${destination}"
  echo
  echo "----------------Downloading UGREEN LED Driver, please wait...!----------------"
  echo "----------This could take some time, please don't close this window!----------"
  download
else
  echo
  echo "----------------------UGREEN LED Driver found locally!------------------------"
fi
}

# Install kernel-module package function
install_kernel_module() {
  /sbin/installpkg "&packages;/${KERNEL_V%%-*}/${KERNEL_PACKAGE}" >/dev/null
  /sbin/depmod -a
}

# Define Variables
KERNEL_V="$(uname -r)"
EXPECTED_KERNEL_V="&kernel-version;"
KERNEL_PACKAGE="&kernel-package;"
KERNEL_SHA256="&kernel-sha256;"
KERNEL_URL="https://github.com/ich777/unraid-ugreenleds-driver/releases/download/${EXPECTED_KERNEL_V}/${KERNEL_PACKAGE}"

if [ "${KERNEL_V}" != "${EXPECTED_KERNEL_V}" ]; then
  echo
  echo "-----ERROR - ERROR - ERROR - ERROR - ERROR - ERROR - ERROR - ERROR - ERROR-----"
  echo "This reviewed plugin release supports kernel ${EXPECTED_KERNEL_V}, not ${KERNEL_V}."
  echo "Review and publish a new pinned release before installing on another kernel."
  exit 1
fi

# Create package directory for running Kernel
if [ ! -d "&packages;/${KERNEL_V%%-*}" ]; then
  mkdir -p "&packages;/${KERNEL_V%%-*}"
fi

# Create settings file
if [ ! -f "&plugin;/settings.cfg" ]; then
  echo "MAPPING_METHOD=\"ata\"
DISK_SERIAL=\"SN1 SN2 SN3 SN4\"
COLOR_DISK_HEALTH=\"255 255 255\"
BRIGHTNESS_DISK_LEDS=\"255\"
COLOR_DISK_UNAVAIL=\"255 0 0\"
LED_REFRESH_INTERVAL=\"0.5\"
CHECK_DISK_ONLINE_INTERVAL=\"5\"
CHECK_GATEWAY_CONNECTIVITY=\"true\"
COLOR_NETDEV_NORMAL=\"255 165 0\"
COLOR_NETDEV_LINK_100=\"0 255 0\"
COLOR_NETDEV_LINK_1000=\"0 0 255\"
COLOR_NETDEV_LINK_2500=\"255 255 0\"
COLOR_NETDEV_LINK_10000=\"255 255 255\"
COLOR_NETDEV_GATEWAY_UNREACHABLE=\"255 0 0\"
CHECK_NETDEV_INTERVAL=\"30\"
BRIGHTNESS_NIGHT=\"15\"
BRIGHTNESS_POWER_DAY=\"128\"
NIGHT_MODE_ENABLED=\"false\"
NIGHT_START_HOUR=\"22\"
NIGHT_END_HOUR=\"7\"
DISK_LED_INVERT=\"1\"
NETDEV_LED_MODE=\"netdev\"
ARRAY_HEALTH_LED=\"false\"
PARITY_PROGRESS_LED=\"true\"
UPS_ALERT_LED=\"true\"" > &plugin;/settings.cfg
fi

# fork: migrate existing settings.cfg - add new keys if missing
if ! grep -q "NIGHT_MODE_ENABLED" "&plugin;/settings.cfg"; then
  echo 'BRIGHTNESS_NIGHT="15"' >> &plugin;/settings.cfg
  echo 'BRIGHTNESS_POWER_DAY="128"' >> &plugin;/settings.cfg
  echo 'NIGHT_MODE_ENABLED="false"' >> &plugin;/settings.cfg
  echo 'NIGHT_START_HOUR="22"' >> &plugin;/settings.cfg
  echo 'NIGHT_END_HOUR="7"' >> &plugin;/settings.cfg
  echo 'DISK_LED_INVERT="1"' >> &plugin;/settings.cfg
fi

# fork: migrate existing settings.cfg - add NETDEV_LED_MODE if missing (separate from the block above,
# since installs updated before this feature already have NIGHT_MODE_ENABLED but not this key)
if ! grep -q "NETDEV_LED_MODE" "&plugin;/settings.cfg"; then
  echo 'NETDEV_LED_MODE="netdev"' >> &plugin;/settings.cfg
fi

# fork: migrate existing settings.cfg - add health/parity/UPS keys if missing (separate guard,
# since installs updated before this feature already have NETDEV_LED_MODE but not these keys)
if ! grep -q "ARRAY_HEALTH_LED" "&plugin;/settings.cfg"; then
  echo 'ARRAY_HEALTH_LED="false"' >> &plugin;/settings.cfg
  echo 'PARITY_PROGRESS_LED="true"' >> &plugin;/settings.cfg
  echo 'UPS_ALERT_LED="true"' >> &plugin;/settings.cfg
fi

# Check for old kernel-package directories
find "&packages;" -mindepth 1 -maxdepth 1 -type d ! -name "${KERNEL_V%%-*}" -exec rm -rf -- {} +

# Check if UGREEN LED Driver is already downloaded
check

# Check if UGREEN LED Driver module is already installed
if ! modinfo led-ugreen -0 >/dev/null 2>&amp;1 ; then
  install_kernel_module
fi

# Check if ugreen-leds script is already started
if ! pgrep -f "/usr/bin/ugreen-leds" >/dev/null 2>&amp;1 ; then
  # fork: clear stale lockfile (daemon died without running its EXIT trap)
  rm -f /var/run/ugreen-leds.lock
  echo "/usr/bin/ugreen-leds" | at now -M
else
  kill $(pgrep -f "/usr/bin/ugreen-leds") >/dev/null 2>&amp;1
  sleep 1
  # fork: clear stale lockfile (daemon killed without running its EXIT trap)
  rm -f /var/run/ugreen-leds.lock
  echo "/usr/bin/ugreen-leds" | at now -M
fi

# fork: regenerate night mode cron on every install/boot
bash &emhttp;/include/apply.sh cron

# Download logo
if [ ! -f "&plugin;/&name;.png" ]; then
  wget -q -nc --show-progress --progress=bar:force:noscroll -O "&plugin;/&name;.png" "https://raw.githubusercontent.com/ich777/docker-templates/3d0bc3590ceb397c2fa8fad37dff1674d60294a6/ich777/images/ugreennas.png"
fi

#Install icon
if [ ! -f "&emhttp;/images/&name;.png" ]; then
  if [ ! -d "&emhttp;/images" ]; then
    mkdir -p &emhttp;/images
  fi
  cp &plugin;/&name;.png &emhttp;/images/
fi

# Download and install the reviewed Plugin Update Helper.
HELPER_URL="https://raw.githubusercontent.com/ich777/unraid-plugin_update_helper/&helper-commit;/plugin_update_helper"
HELPER_SHA256="&helper-sha256;"
HELPER_PATH="&plugin;/plugin_update_helper"
HELPER_TEMP="${HELPER_PATH}.tmp"

if [ ! -f "${HELPER_PATH}" ] || ! echo "${HELPER_SHA256}  ${HELPER_PATH}" | sha256sum -c - >/dev/null 2>&amp;1 ; then
  rm -f "${HELPER_TEMP}"
  if ! wget -q -T 5 -O "${HELPER_TEMP}" "${HELPER_URL}" ; then
    echo "Failed to download the pinned Plugin Update Helper."
    rm -f "${HELPER_TEMP}"
    exit 1
  fi
  if ! echo "${HELPER_SHA256}  ${HELPER_TEMP}" | sha256sum -c - >/dev/null 2>&amp;1 ; then
    echo "Plugin Update Helper checksum verification failed."
    rm -f "${HELPER_TEMP}"
    exit 1
  fi
  mv -f "${HELPER_TEMP}" "${HELPER_PATH}"
fi

if [ ! -f /usr/bin/plugin_update_helper ] || ! echo "${HELPER_SHA256}  /usr/bin/plugin_update_helper" | sha256sum -c - >/dev/null 2>&amp;1 ; then
  pkill -f "inotifywait -q /boot/changes.txt -e move_self,delete_self,modify" >/dev/null 2>&amp;1 || true
  /usr/bin/install -m 0755 "${HELPER_PATH}" /usr/bin/plugin_update_helper
fi

#Start Plugin Update Helper
if [ -z "$(ps aux | grep -E "inotifywait -q /boot/changes.txt -e move_self,delete_self" | grep -v "grep -E inotifywait" | awk '{print $2}')" ]; then
  echo "/usr/bin/plugin_update_helper" | at now &gt; /dev/null 2&gt;&amp;1
fi

echo
echo "-----------------Installation of UGREEN LED Driver successful-----------------"
echo

</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>

echo "----------------------------------------"
echo "-----Uninstalling UGREEN LED Driver-----"
echo "----------------------------------------"
kill $(pgrep -f "/usr/bin/ugreen-leds") >/dev/null 2>&amp;1
# fork: remove night mode cron before the plugin directory goes away
rm -f &plugin;/night-mode.cron
command -v update_cron >/dev/null 2>&amp;1 &amp;&amp; update_cron
# Remove plugin related files
removepkg &name;-&package-version; >/dev/null 2>&amp;1
rm -rf &plugin;
# fork: remove settings UI page
rm -rf &emhttp;
echo
echo "---------------------------------------------------------------------------"
echo "---------UGREEN LED Driver uninstalled, please reboot your server!---------"
echo "---------------------------------------------------------------------------"
echo

</INLINE>
</FILE>
</PLUGIN>
